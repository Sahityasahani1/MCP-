# ==============================================================================
# Autonomous ML Research Agent (AMRA) - Environment Configuration
# ==============================================================================

# 1. Model Provider Selection: "gemini" (Recommended Free Cloud) | "groq" | "ollama"
MODEL_PROVIDER=gemini

# 2. Google Gemini API (Free tier from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# 3. Groq Cloud (Free tier from Groq Console: https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# 4. Ollama Local (If using MODEL_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b

# 5. Kaggle API Credentials (https://www.kaggle.com/settings -> Create New Token)
# If left empty, AMRA operates in Mock/Benchmark mode with pre-bundled datasets.
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_key

# 6. Storage & Limits
MAX_DATASET_DOWNLOAD_MB=250
DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./processed_data
